code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, ambient_light_disabled;

uniform vec4 TomoTrailHeadColor : source_color;
uniform vec2 AnimationSpeed;
uniform sampler2D tex_frg_3 : source_color;
uniform sampler2D tex_frg_4;
uniform float Transparency : hint_range(0.0, 1.0);
uniform vec4 Emission : source_color;



void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = TomoTrailHeadColor;


// Input:8
	float n_out8p0 = TIME;


// Vector2Parameter:10
	vec2 n_out10p0 = AnimationSpeed;
	float n_out10p2 = n_out10p0.g;


// VectorOp:9
	vec2 n_out9p0 = vec2(n_out8p0) * vec2(n_out10p2);


// UVFunc:7
	vec2 n_in7p1 = vec2(1.00000, 1.00000);
	vec2 n_out7p0 = n_out9p0 * n_in7p1 + UV;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, n_out7p0);
	float n_out3p1 = n_out3p0.r;


// Texture2D:4
	vec4 n_out4p0 = texture(tex_frg_4, UV);
	float n_out4p1 = n_out4p0.r;


// FloatOp:5
	float n_out5p0 = n_out3p1 - n_out4p1;


// FloatParameter:13
	float n_out13p0 = Transparency;


// FloatOp:12
	float n_out12p0 = n_out5p0 - n_out13p0;


// Clamp:6
	float n_in6p1 = 0.00000;
	float n_in6p2 = 1.00000;
	float n_out6p0 = clamp(n_out12p0, n_in6p1, n_in6p2);


// ColorParameter:11
	vec4 n_out11p0 = Emission;


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out6p0;
	EMISSION = vec3(n_out11p0.xyz);


}
